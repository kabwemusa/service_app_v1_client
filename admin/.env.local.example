# Laravel backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin JWT signing secret — must match ADMIN_JWT_SECRET in Laravel .env
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-in-production

# Cookie domain (leave blank for localhost)
ADMIN_COOKIE_DOMAIN=

# Session idle timeout in minutes (default 30)
ADMIN_IDLE_TIMEOUT_MINS=30

# MFA is required for all admin accounts in production (set to false for local dev only)
ADMIN_MFA_REQUIRED=true
