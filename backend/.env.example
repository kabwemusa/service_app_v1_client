APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Typesense ───────────────────────────────────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=ssm_typesense_dev_key
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=2

# ── Ranking Engine (Section 4.1) ────────────────────────────────────────────
RANKING_ALPHA=0.40
RANKING_BETA=0.30
RANKING_GAMMA=0.15
RANKING_DELTA=0.15
RANKING_LAMBDA=0.05
RANKING_MIN_REVIEWS=5
COLD_START_BOOST=2.0
COLD_START_JOB_THRESHOLD=3

# ── Search ──────────────────────────────────────────────────────────────────
MAX_SEARCH_RADIUS_KM=10
MAX_SEARCH_RESULTS=20

# ── Scheduling ──────────────────────────────────────────────────────────────
TRANSIT_SPEED_KMH=30
TRANSIT_BUFFER_MINS=15

# ── Escrow ──────────────────────────────────────────────────────────────────
PAYMENT_TTL_MINS=60
DISPUTE_WINDOW_HOURS=48
DISPUTE_SLA_HOURS=72

# ── Trust / NLP ─────────────────────────────────────────────────────────────
TRUST_THRESHOLD=0.40
RISK_THRESHOLD=0.70
NLP_REDACT_THRESHOLD=0.80

# ── Payout Retry ────────────────────────────────────────────────────────────
PAYOUT_RETRY_1_MINS=5
PAYOUT_RETRY_2_MINS=30
PAYOUT_RETRY_3_MINS=120
PAYOUT_MAX_RETRIES=3

# ── Payment / Escrow ─────────────────────────────────────────────────────────
PLATFORM_FEE_PCT=0.05
PAYMENT_TTL_MINS=60
DISPUTE_WINDOW_HOURS=48
DISPUTE_SLA_HOURS=72
PAYOUT_RETRY_1_MINS=5
PAYOUT_RETRY_2_MINS=30
PAYOUT_RETRY_3_MINS=120
PAYOUT_MAX_RETRIES=3

# ── MTN MoMo Gateway ─────────────────────────────────────────────────────────
# Base URL: sandbox → https://sandbox.momodeveloper.mtn.com
#           production → https://proxy.momoapi.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_CURRENCY=ZMW

# How long to wait for a MoMo transaction to resolve.
# Default: 24 polls × 5 000 ms = 2 minutes max per transaction.
MOMO_POLL_MAX_ATTEMPTS=24
MOMO_POLL_INTERVAL_MS=5000

# Collections (RequestToPay — charging the customer)
# Get these from momodeveloper.mtn.com → Collections product
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_COLLECTIONS_API_USER_ID=
MOMO_COLLECTIONS_API_KEY=

# Disbursements (Transfer — paying out to provider or refunding buyer)
# Get these from momodeveloper.mtn.com → Disbursements product
MOMO_DISBURSEMENTS_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENTS_API_USER_ID=
MOMO_DISBURSEMENTS_API_KEY=
