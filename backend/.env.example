APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Typesense ───────────────────────────────────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=ssm_typesense_dev_key
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=2

# ── Ranking Engine (v3.2 §1.3 — all features normalized to [0,1]) ───────────
RANK_W_RATING=0.25
RANK_W_COMPLETION=0.15
RANK_W_VERIFICATION=0.15
RANK_W_RESPONSE=0.10
RANK_W_FRESHNESS=0.05
RANK_W_PROXIMITY=0.20
RANK_W_PRICE=0.10
RANK_COLD_BOOST=0.06
RANK_COLD_JOB_THRESHOLD=3
RANK_TIER1_MULTIPLIER=0.85
RANK_PRICE_FIT_ENABLED=true
PROXIMITY_D0_DEFAULT_KM=4.0
SHRINK_K=5
SHRINK_COMPLETION_PRIOR=0.85
SHRINK_RESPONSE_PRIOR=0.70
RANKING_INACTIVITY_LAMBDA=0.05
RANKING_MIN_REVIEWS=5
RANK_C_MEAN_PRIOR=4.0
FAIRNESS_NEW_PROVIDER_JOBS=10
TRUST_SEARCH_FLOOR=0.40
RANK_PERSONAL_REPEAT_BOOST=0.15
RANK_PERSONAL_CATEGORY_BOOST=0.03

# ── Retention economics (v3.2 §5 repeat-pair taper) ─────────────────────────
REPEAT_TAPER_T1=0.02
REPEAT_TAPER_T2=0.03
REPEAT_TAPER_START=3
REPEAT_TAPER_DEEP=6
REPEAT_PROTECTION_WAIVER_CAP_ZMW=20

# ── Trust corrections (v3.2 §4) ─────────────────────────────────────────────
RATING_HALF_LIFE_DAYS=180
KYC_MOMO_NAME_MATCH=true
KYC_MOMO_NAME_MAX_LEVENSHTEIN=2

# ── Post-a-request (v3.2 §6) ────────────────────────────────────────────────
REQUEST_NOTIFY_TOP_N=10
REQUEST_RESPONSE_DEADLINE_MINS=30
REQUEST_MAX_OPEN_PER_BUYER=3

# ── Search ──────────────────────────────────────────────────────────────────
# No radius: candidacy widens by region tier (area → city → province → national).
MAX_SEARCH_RESULTS=20
# Widen to the next region tier until at least this many candidates are found.
SEARCH_WIDEN_TARGET=8
# Resolve a provider/service's region from its coordinates on save (geocoder).
SEARCH_AUTO_RESOLVE_REGIONS=true

# ── Geocoding (v3.2 §3.1 — hybrid drivers) ──────────────────────────────────
GEOCODER_FORWARD=nominatim
GEOCODER_REVERSE=nominatim
GOOGLE_PLACES_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_REVERSE_CACHE_TTL_DAYS=30
GAZETTEER_MIN_CONFIRMS=3

# Master driver switch / feature flag. Empty = keep nominatim+google behaviour.
# Set to "photon" to make the self-hosted Photon instance the forward primary
# (Google as cost-bounding fallback) and the reverse primary, with no code change.
GEOCODER_DRIVER=
# Optional explicit forward fallback chain (comma-separated, first non-empty
# wins). Empty ⇒ derived from GEOCODER_DRIVER. e.g. "photon,google".
GEOCODER_FORWARD_CHAIN=

# ── Self-hosted Photon (Zambia-tuned) — see PHOTON_GEOCODING_RUNBOOK.md ──────
PHOTON_BASE_URL=http://localhost:2322
# Zambia extent: minLon,minLat,maxLon,maxLat — hard-restricts results to Zambia.
PHOTON_BBOX=21.99,-18.08,33.71,-8.22
PHOTON_LANG=en
PHOTON_LIMIT=5
PHOTON_TIMEOUT=5
# Forward proximity bias (0–1, higher = stronger). Fallback centre = Lusaka CBD.
PHOTON_BIAS_SCALE=0.7
PHOTON_ZOOM=
PHOTON_FALLBACK_LAT=-15.4167
PHOTON_FALLBACK_LON=28.2833
# Label granularities surfaced. `house` is kept on purpose: Photon files
# landmark POIs (malls/markets/stadiums) under `house`, and landmark search is
# the primary addressing mode in Zambia. Drop it only for admin/street-only.
PHOTON_LAYERS=city,locality,district,street,house
# Reverse search radius (km) so thin-coverage lookups don't snap far away.
PHOTON_REVERSE_RADIUS_KM=3
# Orchestration toggles (sensible defaults; override per environment).
GAZETTEER_SHORT_CIRCUIT=false
GAZETTEER_QUERY_REWRITE=false
GEOCODE_REVERSE_SNAP=true

# ── Scheduling (v3.2 §1.6 transit feasibility) ──────────────────────────────
TRANSIT_CIRCUITY=1.35
TRANSIT_SPEED_PEAK_KMH=20
TRANSIT_SPEED_OFFPEAK_KMH=30
TRANSIT_BUFFER_MINS=15

# ── Payment mode (DIRECT = no MoMo, ESCROW = fund custody) ─────────────────
# ESCROW is the platform default now that PawaPay provides compliant custody.
# Per-booking payment_mode is immutable: existing DIRECT bookings finish DIRECT.
PAYMENT_MODE=ESCROW
BOOKING_RESPONSE_WINDOW_HOURS=24
BOOKING_AUTOCONFIRM_HOURS=24

# ── Escrow ──────────────────────────────────────────────────────────────────
PAYMENT_TTL_MINS=60
DISPUTE_WINDOW_HOURS=48
DISPUTE_SLA_HOURS=72

# ── Trust / NLP ─────────────────────────────────────────────────────────────
TRUST_THRESHOLD=0.40
RISK_THRESHOLD=0.70
NLP_REDACT_THRESHOLD=0.80

# ── Payout Retry ────────────────────────────────────────────────────────────
PAYOUT_RETRY_1_MINS=5
PAYOUT_RETRY_2_MINS=30
PAYOUT_RETRY_3_MINS=120
PAYOUT_MAX_RETRIES=3

# ── Payment / Escrow ─────────────────────────────────────────────────────────
PLATFORM_FEE_PCT=0.05
PAYMENT_TTL_MINS=60
DISPUTE_WINDOW_HOURS=48
DISPUTE_SLA_HOURS=72
PAYOUT_RETRY_1_MINS=5
PAYOUT_RETRY_2_MINS=30
PAYOUT_RETRY_3_MINS=120
PAYOUT_MAX_RETRIES=3

# ── Dispatch Engine (Phase 3) ────────────────────────────────────────────────
DISPATCH_SHORTLIST_SIZE=3
DISPATCH_GEO_RING1_KM=5
DISPATCH_GEO_RING2_KM=25
DISPATCH_GEO_RING3_KM=100
DISPATCH_FAIRNESS_SHARE=0.20
DISPATCH_FAIRNESS_PROBATION_JOBS=10
DISPATCH_ACCEPT_WINDOW_MINS=15
DISPATCH_ACCEPT_URGENT_MINS=5
DISPATCH_DECAY_LAMBDA=0.005
DISPATCH_SHRINK_K=5
DISPATCH_RELIABILITY_PRIOR=70
DISPATCH_FINANCIAL_PRIOR=80
DISPATCH_DISPUTE_PRIOR=0.05
DISPATCH_RATING_PRIOR=3.5
DISPATCH_RATING_HALF_LIFE=180

# ── WhatsApp Cloud API (Phase 2) ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=sebenza_webhook_verify_token
GRAPH_API_VERSION=v21.0
WHATSAPP_TEST_MODE=true
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── PawaPay Mobile Money Gateway ────────────────────────────────────────────
PAWAPAY_ENABLED=false
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_CURRENCY=ZMW
PAWAPAY_COUNTRY=ZMB
PAWAPAY_STATEMENT=Sebenza
# Sandbox testing only — forces the deposit payer to a pawaPay test MSISDN so the
# outcome is deterministic. Leave blank in production. 260973456789 → COMPLETED.
PAWAPAY_SANDBOX_FORCE_PAYER=

# ── MTN MoMo Gateway (legacy — replaced by PawaPay) ─────────────────────────
# Base URL: sandbox → https://sandbox.momodeveloper.mtn.com
#           production → https://proxy.momoapi.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_CURRENCY=ZMW

# How long to wait for a MoMo transaction to resolve.
# Default: 24 polls × 5 000 ms = 2 minutes max per transaction.
MOMO_POLL_MAX_ATTEMPTS=24
MOMO_POLL_INTERVAL_MS=5000

# Collections (RequestToPay — charging the customer)
# Get these from momodeveloper.mtn.com → Collections product
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_COLLECTIONS_API_USER_ID=
MOMO_COLLECTIONS_API_KEY=

# Disbursements (Transfer — paying out to provider or refunding buyer)
# Get these from momodeveloper.mtn.com → Disbursements product
MOMO_DISBURSEMENTS_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENTS_API_USER_ID=
MOMO_DISBURSEMENTS_API_KEY=
